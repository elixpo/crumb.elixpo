{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crumb.elixpo.com/marketplace/schema/catalog.schema.json",
  "title": "Crumb marketplace catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "name", "packages"],
  "properties": {
    "schema_version": { "const": 1 },
    "name": { "$ref": "#/$defs/slug" },
    "packages": {
      "type": "array",
      "items": { "$ref": "#/$defs/package" }
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9-]+$"
    },
    "componentId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "kind", "display_name", "description", "license", "source"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+/[a-z0-9-]+$"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9.+-]+$"
        },
        "kind": { "enum": ["skill", "mcp", "bundle"] },
        "display_name": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "license": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": ["workspace_read", "workspace_write", "process_execution", "network_access"]
          }
        },
        "artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256"],
            "properties": {
              "path": { "$ref": "#/$defs/relativePath" },
              "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" }
            }
          }
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "path"],
            "properties": {
              "id": { "$ref": "#/$defs/componentId" },
              "path": { "$ref": "#/$defs/relativePath" }
            }
          }
        },
        "mcp_servers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "command"],
            "properties": {
              "id": { "$ref": "#/$defs/componentId" },
              "command": { "type": "string", "minLength": 1 },
              "arguments": { "type": "array", "items": { "type": "string" } },
              "environment": {
                "type": "array",
                "uniqueItems": true,
                "items": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" }
              }
            }
          }
        }
      },
      "anyOf": [
        { "required": ["skills"] },
        { "required": ["mcp_servers"] }
      ]
    }
  }
}
